---
import BaseLayout from '../layouts/BaseLayout.astro'
import FinalCTA from '../components/sections/FinalCTA.astro'
import { APP_URL } from '../constants'
import '../styles/print.css'
---

<BaseLayout
  title="Product Introduction — Start POS"
  description="Discover Start POS: A modern, offline-first, multi-tenant Point of Sale system designed for retail, restaurant, and grocery businesses."
>

  <!-- Print-Only Header -->
  <div class="print-only" style="display: none;">
    <div style="text-align: center; padding: 0.3rem 0; border-bottom: 2px solid #10b981; margin-bottom: 0.4rem;">
      <h1 style="font-size: 1.3rem; font-weight: 900; color: #0f172a; margin: 0; line-height: 1.2;">Start POS</h1>
      <p style="font-size: 0.8rem; color: #475569; margin: 0.1rem 0 0 0;">Product Introduction</p>
      <p style="font-size: 0.7rem; color: #64748b; margin: 0.1rem 0 0 0;">startpos.ph | hello@startpos.ph</p>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-900 pt-20 pb-28 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.06)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.06)_1px,transparent_1px)] bg-[size:64px_64px]"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-white mb-6 leading-tight">
          Your Business.<br/>Your Rules.<br/><span class="text-emerald-400">Anywhere.</span>
        </h1>
        <p class="text-xl sm:text-2xl text-slate-300 mb-8 leading-relaxed">
          Transform how you run your business with <strong class="text-white">Start POS</strong> — 
          a next-generation Point of Sale system that works everywhere, for everyone.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={APP_URL} class="inline-flex items-center justify-center px-8 py-4 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl shadow-lg transition-all hover:shadow-xl hover:scale-105">
            Start Free Trial
          </a>
          <a href="#overview" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold rounded-xl backdrop-blur-sm transition-all border border-white/20">
            Learn More
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section id="overview" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Why Start POS?</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
          Built for businesses that refuse to compromise
        </h2>
        <p class="text-lg text-slate-600">
          Whether you're running a bustling restaurant, a retail store, or a grocery operation, 
          Start POS adapts to your needs — not the other way around.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <div class="text-4xl mb-4">🌐</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Work Anywhere, Anytime</h3>
          <p class="text-slate-600">
            Built with an offline-first architecture. Process sales, manage inventory, and serve customers 
            even when the internet doesn't cooperate. Everything syncs automatically when you're back online.
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">One System, Every Business</h3>
          <p class="text-slate-600">
            Retail, Restaurant, or Grocery — our intelligent system adapts to your industry. 
            Full inventory management, kitchen workflows, and expiration tracking all in one platform.
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl p-8 border border-slate-200">
          <div class="text-4xl mb-4">📈</div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">Scale With Confidence</h3>
          <p class="text-slate-600">
            Start with a single location and grow to multiple branches without switching systems. 
            Multi-tenant architecture with role-based access and branch-specific configurations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Types -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Perfect For</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900">
          Built for your industry
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '🛍️', title: 'Retail Stores', items: ['Clothing', 'Electronics', 'General merchandise', 'Pop-up shops'] },
          { icon: '🍽️', title: 'Restaurants & Cafes', items: ['Quick service', 'Full service', 'Delivery & takeout', 'Food trucks'] },
          { icon: '🥬', title: 'Grocery Stores', items: ['Fresh produce', 'Packaged goods', 'Bulk items', 'Organic markets'] },
          { icon: '✂️', title: 'Service Businesses', items: ['Salons & spas', 'Repair shops', 'Professional services', 'Workshops'] },
          { icon: '🏢', title: 'Multi-Location Chains', items: ['Franchises', 'Corporate branches', 'Regional operations', 'Pop-ups'] },
          { icon: '🌟', title: 'Mixed Operations', items: ['Cafe + retail', 'Restaurant + catering', 'Store + services', 'Hybrid models'] },
        ].map((type) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 hover:shadow-lg transition-shadow">
            <div class="text-3xl mb-3">{type.icon}</div>
            <h3 class="text-lg font-bold text-slate-900 mb-3">{type.title}</h3>
            <ul class="space-y-1.5">
              {type.items.map((item) => (
                <li class="flex items-center gap-2 text-sm text-slate-600">
                  <svg class="shrink-0 text-emerald-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Features Overview -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Features That Work</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900">
          Everything you need, nothing you don't
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Left Column -->
        <div class="space-y-8">
          <div class="flex gap-4">
            <div class="shrink-0 w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center text-2xl">🛒</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Intelligent Product Management</h3>
              <p class="text-slate-600 mb-3">
                Support for physical goods, services, raw materials, and bundles. Product variants, add-ons, 
                Bill of Materials (BOM), flexible pricing, and service duration management.
              </p>
              <ul class="space-y-1">
                {['Categories & SKUs', 'Multiple units', 'Cost & selling price tracking', 'Expiration tracking'].map((item) => (
                  <li class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="shrink-0 text-emerald-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-12 h-12 bg-violet-100 rounded-xl flex items-center justify-center text-2xl">📦</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Complete Inventory Control</h3>
              <p class="text-slate-600 mb-3">
                Multi-location warehousing with batch tracking, expiration monitoring, stock adjustments, 
                internal transfers, and waste management.
              </p>
              <ul class="space-y-1">
                {['Branch-level stock', 'Low-stock alerts', 'Automatic refill tasks', 'Purchase receiving'].map((item) => (
                  <li class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="shrink-0 text-violet-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center text-2xl">💰</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Powerful Sales Features</h3>
              <p class="text-slate-600 mb-3">
                Multiple payment methods, customer management, discounts, automatic tax computation, 
                receipt generation, and complete transaction history.
              </p>
              <ul class="space-y-1">
                {['Cash, card, e-wallet', 'Refunds & adjustments', 'Invoice numbering', 'PDF receipts'].map((item) => (
                  <li class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="shrink-0 text-blue-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Right Column -->
        <div class="space-y-8">
          <div class="flex gap-4">
            <div class="shrink-0 w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center text-2xl">🍽️</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Restaurant-Ready</h3>
              <p class="text-slate-600 mb-3">
                Kitchen order management, order status tracking, table/buzzer support, 
                dine-in/takeout/delivery modes, and customizable add-ons.
              </p>
              <ul class="space-y-1">
                {['Kitchen workflows', 'Order queue', 'Status tracking', 'Deposit management'].map((item) => (
                  <li class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="shrink-0 text-orange-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-12 h-12 bg-pink-100 rounded-xl flex items-center justify-center text-2xl">💼</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Financial Management</h3>
              <p class="text-slate-600 mb-3">
                Cash reconciliation, vendor session tracking, revenue and cost analysis, 
                profit calculations, and payment tracking across all methods.
              </p>
              <ul class="space-y-1">
                {['Vendor sessions', 'Revenue tracking', 'Cost analysis', 'Profit calculations'].map((item) => (
                  <li class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="shrink-0 text-pink-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-12 h-12 bg-teal-100 rounded-xl flex items-center justify-center text-2xl">📋</div>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">Operational Excellence</h3>
              <p class="text-slate-600 mb-3">
                Built-in task management for shelf refills, purchase requests, branch transfers, 
                stock counting, and custom workflows with approval flow.
              </p>
              <ul class="space-y-1">
                {['Task workflows', 'Approval systems', 'Role assignments', 'Status tracking'].map((item) => (
                  <li class="flex items-center gap-2 text-sm text-slate-500">
                    <svg class="shrink-0 text-teal-500" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12 text-center">
        <a href="/features" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-semibold transition-colors">
          View all features in detail
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Configuration System -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Flexibility</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
            Configuration that makes sense
          </h2>
          <p class="text-lg text-slate-600 mb-6">
            Hierarchical settings flow from Business → Branch → User, giving you precise control 
            over every aspect of your operation.
          </p>
          
          <div class="space-y-4">
            {[
              { level: 'Business Level', items: ['Tax rates & currency', 'Compliance settings', 'Invoice configuration'] },
              { level: 'Branch Level', items: ['Inventory thresholds', 'Pricing rules', 'Feature toggles'] },
              { level: 'User Level', items: ['Language & locale', 'Printing preferences', 'Personal dashboards'] },
            ].map((config) => (
              <div class="bg-white rounded-lg p-4 border border-slate-200">
                <h3 class="font-bold text-slate-900 mb-2">{config.level}</h3>
                <div class="flex flex-wrap gap-2">
                  {config.items.map((item) => (
                    <span class="text-xs px-2.5 py-1 bg-slate-100 text-slate-600 rounded-full">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-slate-200 shadow-lg">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-emerald-100 rounded-xl flex items-center justify-center text-3xl">🏢</div>
              <div class="flex-1">
                <div class="text-sm font-semibold text-slate-500 mb-1">Business Settings</div>
                <div class="h-2 bg-emerald-100 rounded-full overflow-hidden">
                  <div class="h-full w-full bg-emerald-500"></div>
                </div>
              </div>
            </div>
            
            <div class="ml-8 border-l-2 border-slate-200 pl-8 space-y-6">
              <div class="flex items-center gap-4">
                <div class="w-16 h-16 bg-violet-100 rounded-xl flex items-center justify-center text-3xl">🏪</div>
                <div class="flex-1">
                  <div class="text-sm font-semibold text-slate-500 mb-1">Branch Settings</div>
                  <div class="h-2 bg-violet-100 rounded-full overflow-hidden">
                    <div class="h-full w-4/5 bg-violet-500"></div>
                  </div>
                </div>
              </div>
              
              <div class="ml-8 border-l-2 border-slate-200 pl-8">
                <div class="flex items-center gap-4">
                  <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center text-3xl">👤</div>
                  <div class="flex-1">
                    <div class="text-sm font-semibold text-slate-500 mb-1">User Settings</div>
                    <div class="h-2 bg-blue-100 rounded-full overflow-hidden">
                      <div class="h-full w-3/5 bg-blue-500"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-8 lg:p-12 text-white order-2 lg:order-1">
          <div class="text-4xl mb-4">🧾</div>
          <h3 class="text-2xl font-bold mb-4">Compliance Built-In</h3>
          <p class="text-slate-300 mb-6">
            Designed for global operations with built-in support for Philippines BIR requirements 
            and a framework ready for other Southeast Asian markets.
          </p>
          <ul class="space-y-3">
            {[
              'VAT, GST, and Sales Tax',
              'Multiple invoice types',
              'Tax categories & exemptions',
              'Compliance registry',
              'Sequential numbering',
              'Country-specific requirements',
            ].map((item) => (
              <li class="flex items-center gap-3">
                <svg class="shrink-0 text-emerald-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class="text-slate-200">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="order-1 lg:order-2">
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Global Ready</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
            Stay compliant, everywhere
          </h2>
          <p class="text-lg text-slate-600 mb-6">
            Tax regulations vary by country, but compliance shouldn't be complicated. 
            Start POS handles the complexity so you can focus on your business.
          </p>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 bg-emerald-100 rounded-lg flex items-center justify-center text-emerald-600 font-bold text-sm">PH</div>
              <div>
                <div class="font-semibold text-slate-900">Philippines</div>
                <div class="text-sm text-slate-600">Full BIR compliance with PTU, VAT, and invoice numbering</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold text-sm">SG</div>
              <div>
                <div class="font-semibold text-slate-900">Singapore & Malaysia</div>
                <div class="text-sm text-slate-600">GST-ready architecture for regional expansion</div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-8 h-8 bg-violet-100 rounded-lg flex items-center justify-center text-violet-600 font-bold text-sm">+</div>
              <div>
                <div class="font-semibold text-slate-900">More Countries</div>
                <div class="text-sm text-slate-600">Extensible framework for additional tax systems</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technology -->
  <section class="py-20 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Technology</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black mb-4">
          Modern stack, reliable performance
        </h2>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Built on cutting-edge technology for speed, reliability, and developer-friendly customization.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { icon: '⚡', title: 'Lightning Fast', desc: 'React 19 interface with instant responsiveness' },
          { icon: '💾', title: 'Local-First', desc: 'TanStack DB for offline-capable data storage' },
          { icon: '🔄', title: 'Auto-Sync', desc: 'Background synchronization when online' },
          { icon: '📱', title: 'Progressive', desc: 'PWA capabilities for mobile & desktop' },
          { icon: '🗄️', title: 'Enterprise DB', desc: 'PostgreSQL backend with Prisma ORM' },
          { icon: '🔐', title: 'Secure', desc: 'Better Auth with role-based access control' },
          { icon: '✅', title: 'Type-Safe', desc: 'Full TypeScript for reliability' },
          { icon: '🎨', title: 'Beautiful UI', desc: 'Tailwind CSS v4 with modern design' },
        ].map((tech) => (
          <div class="bg-slate-800 rounded-xl p-6 border border-slate-700">
            <div class="text-3xl mb-3">{tech.icon}</div>
            <h3 class="font-bold text-white mb-2">{tech.title}</h3>
            <p class="text-sm text-slate-400">{tech.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Next -->
  <section class="py-20 bg-gradient-to-br from-emerald-50 to-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Roadmap</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black text-slate-900 mb-4">
          What's next?
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          We're constantly evolving. Here's what's coming to Start POS in the near future.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '☁️', title: 'Cloud Synchronization', desc: 'Multi-device access with real-time sync' },
          { icon: '👥', title: 'Real-Time Collaboration', desc: 'Multiple users working together seamlessly' },
          { icon: '📱', title: 'Barcode Scanner', desc: 'Native barcode scanning integration' },
          { icon: '🎨', title: 'Receipt Designer', desc: 'Custom receipt templates and branding' },
          { icon: '📺', title: 'Kitchen Display System', desc: 'Dedicated KDS for restaurant workflows' },
          { icon: '⭐', title: 'Customer Loyalty', desc: 'Points, rewards, and membership programs' },
          { icon: '🎁', title: 'Promotions Engine', desc: 'Advanced discount and campaign management' },
          { icon: '💱', title: 'Multi-Currency', desc: 'Support for international transactions' },
          { icon: '📊', title: 'Analytics Dashboard', desc: 'Business intelligence and forecasting' },
          { icon: '🤖', title: 'AI Forecasting', desc: 'Inventory predictions powered by AI' },
          { icon: '🧩', title: 'Plugin System', desc: 'Extensible architecture for custom features' },
          { icon: '🔗', title: 'API Access', desc: 'Full REST API for integrations' },
        ].map((feature) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 hover:shadow-lg transition-shadow">
            <div class="text-3xl mb-3">{feature.icon}</div>
